{
    "name": "topthink/think",
    "description": "ThinkPress: a maintainable ThinkPHP article management application",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "https://www.thinkphp.cn/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "liu21st",
            "email": "liu21st@gmail.com"
        },
        {
            "name": "yunwuxin",
            "email": "448901948@qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "topthink/framework": "^8.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "topthink/think-orm": "^4.0",
        "topthink/think-view": "^2.0"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ],
        "test": "@php tests/run.php",
        "check": "@php tests/lint.php"
    }
}
